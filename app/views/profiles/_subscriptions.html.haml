-# Renders the grouped list of a user's subscribed cliqs.
-# Requires locals: user:, subscribed_groups:
- return unless current_user&.id == user.id

%section.mt-6
  %h2.text-lg.font-semibold.mb-3 Subscribed Cliqs

  - if subscribed_groups.blank?
    %p.text-sm.text-gray-500 You haven't subscribed to any Cliqs yet.
  - else
    - subscribed_groups.each do |parent, cliqs|
      .mb-4
        .text-sm.font-medium.mb-1= link_to(parent.name, cliq_path(parent))
        .rounded-lg.border.border-gray-200.divide-y
          - cliqs.sort_by(&:name).each do |cliq|
            - subscription = current_user.subscriptions.find { |s| s.cliq_id == cliq.id } || current_user.subscriptions.find_by(cliq_id: cliq.id)
            - next unless subscription
            = render "subscriptions/row", subscription: subscription
