-# Renders the subscribe/unsubscribe toggle for a cliq inside a Turbo frame.
-# Locals: cliq
- direct_sub = current_user&.subscription_for(cliq)
- inherited_from = current_user&.subscribed_ancestor_for(cliq)

= turbo_frame_tag(dom_id(cliq, :subscribe_button)) do
  - if current_user.nil?
    = link_to "Sign in to subscribe", new_user_session_path, class: "btn btn-sm"

  - elsif direct_sub
    = button_to "Unsubscribe",
      subscription_path(direct_sub),
      method: :delete,
      params: { context: "cliq_button" },
      form: { data: { turbo_frame: dom_id(cliq, :subscribe_button) } },
      class: "btn btn-outline btn-sm"

  - elsif inherited_from
    .flex.items-center.gap-2
      %span.text-xs.text-slate-600
        Subscribed via
        = link_to inherited_from.name,
                  cliq_path(inherited_from),
                  data: { turbo_frame: "_top", turbo_action: "advance" }
      - ancestor_sub = current_user.subscription_for(inherited_from)
      - if ancestor_sub
        = button_to "Unsubscribe #{inherited_from.name}",
          subscription_path(ancestor_sub),
          method: :delete,
          params: { context: "cliq_button", target_cliq_id: cliq.id },
          form: { data: { turbo_frame: dom_id(cliq, :subscribe_button) } },
          class: "btn btn-outline btn-sm"

  - else
    = button_to "Subscribe",
      subscriptions_path(cliq_id: cliq.id),
      method: :post,
      form: { data: { turbo_frame: dom_id(cliq, :subscribe_button) } },
      class: "btn btn-outline btn-sm"
