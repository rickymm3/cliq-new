= turbo_frame_tag "main_content" do
  .container
    .row.g-4
      / LEFT sidebar
      .col-lg-3.d-none.d-lg-block.sidebar-left
        = render "cliqs/sidebar", cliq: @cliq

      / CENTER: posts
      .col-lg-6
        .space-y-4
          - if @posts.any?
            = render "posts"
          - else
            .rounded-xl.border.border-slate-200.bg-white.p-8.text-center.text-slate-500
              No posts yet. Be the first to share something!
          = render "pager", pagy: @pagy, cliq: @cliq

      / RIGHT sidebar: cliq info
      .col-lg-3.d-none.d-lg-block.sidebar-right
        = render "cliqs/sidebar_cliq_info", cliq: @cliq
